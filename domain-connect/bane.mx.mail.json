{
  "providerId": "bane.mx",
  "providerName": "Nightmail",
  "serviceId": "mail",
  "serviceName": "Mail",
  "version": 3,
  "description": "Authenticate sending, prove domain ownership, and optionally configure receiving, custom MAIL FROM and branded tracking for Nightmail.",
  "logoUrl": "https://bane.mx/favicon.svg",
  "syncBlock": false,
  "syncPubKeyDomain": "domainconnect.bane.mx",
  "syncRedirectDomain": "nightmail.com,bane.mx",
  "hostRequired": false,
  "records": [
    { "groupId": "sending", "type": "CNAME", "host": "%dkim1%._domainkey", "pointsTo": "%dkim1%.%dkimZone%.amazonses.com", "ttl": 3600 },
    { "groupId": "sending", "type": "CNAME", "host": "%dkim2%._domainkey", "pointsTo": "%dkim2%.%dkimZone%.amazonses.com", "ttl": 3600 },
    { "groupId": "sending", "type": "CNAME", "host": "%dkim3%._domainkey", "pointsTo": "%dkim3%.%dkimZone%.amazonses.com", "ttl": 3600 },
    { "groupId": "ownership", "type": "TXT", "host": "_nightmail", "data": "%ownership%", "txtConflictMatchingMode": "All", "ttl": 3600 },
    { "groupId": "receiving", "type": "MX", "host": "@", "pointsTo": "inbound-smtp.%inboundRegion%.amazonaws.com", "priority": 10, "ttl": 3600, "essential": "OnApply" },
    { "groupId": "receivingReply", "type": "MX", "host": "reply", "pointsTo": "inbound-smtp.%inboundRegion%.amazonaws.com", "priority": 10, "ttl": 3600, "essential": "OnApply" },
    { "groupId": "mailfrom", "type": "MX", "host": "email", "pointsTo": "feedback-smtp.%region%.amazonses.com", "priority": 10, "ttl": 3600, "essential": "OnApply" },
    { "groupId": "mailfrom", "type": "SPFM", "host": "email", "spfRules": "include:amazonses.com", "ttl": 3600, "essential": "OnApply" },
    { "groupId": "tracking", "type": "CNAME", "host": "track", "pointsTo": "%trackingDistribution%.cloudfront.net", "ttl": 3600 }
  ]
}
