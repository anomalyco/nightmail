// Support, production (support.nightmail.dev; support.bane.mx stays a custom domain for links already sent): the support agent's Worker beside bane-production in anomaly-production. Service bindings
// only work inside one account, so dev binds bane-dev and production binds bane-production. See support/README.md for
// the one-time setup (D1 database, address, webhook, secrets) and the deploy.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nightmail-support",
  "account_id": "15d29c8639fd3733b1b5486a2acfd968",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "support.nightmail.dev", "custom_domain": true }, { "pattern": "support.bane.mx", "custom_domain": true }],
  "minify": true,
  // The system prompt and the voice guide are Markdown files bundled as text.
  "rules": [{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }],
  "durable_objects": { "bindings": [{ "name": "CONVERSATION", "class_name": "SupportConversation" }, { "name": "INTAKE", "class_name": "SupportIntake" }] },
  "migrations": [{ "tag": "transfer-from-bane-support", "transferred_classes": [
    { "from_script": "bane-support", "from": "SupportConversation", "to": "SupportConversation" },
    { "from_script": "bane-support", "from": "SupportIntake", "to": "SupportIntake" }
  ] }],
  // Created 2026-11-13 in anomaly-production (ENAM).
  "d1_databases": [{ "binding": "DB", "database_name": "nightmail-support", "database_id": "816f937d-ad05-4987-8c27-9b1a1e99ee32", "migrations_dir": "migrations" }],
  // Screenshots (chat uploads and email image attachments): private, with a 90-day lifecycle rule (support/README.md).
  "r2_buckets": [{ "binding": "UPLOADS", "bucket_name": "nightmail-support-uploads" }],
  // Downscales screenshots too large to send to the model (Cloudflare Images binding; optional in code).
  "images": { "binding": "IMAGES" },
  "services": [
    // Nightmail's SupportPlatform entrypoint (api/src/support-platform.ts): handoffs, sender checks, grants, grant reads.
    { "binding": "BANE", "service": "nightmail-production", "entrypoint": "SupportPlatform" },
    // Nightmail's public API, called with the support address's API key (limited to that address).
    { "binding": "BANE_API", "service": "nightmail-production" }
  ],
  // Rate limiter namespaces are per account; Nightmail's own use 8794001–8794002.
  "ratelimits": [
    { "name": "CHAT_START", "namespace_id": "8794101", "simple": { "limit": 5, "period": 60 } },
    // Per sender address; and one key across all inbound mail at a higher rate (the Worker answers 503, Nightmail retries).
    { "name": "EMAIL_IN", "namespace_id": "8794102", "simple": { "limit": 10, "period": 60 } },
    { "name": "EMAIL_IN_GLOBAL", "namespace_id": "8794103", "simple": { "limit": 120, "period": 60 } },
    // Nightmail's content-free wakes after a staff reply (src/worker.ts wake): one key for all.
    { "name": "WAKE", "namespace_id": "8794104", "simple": { "limit": 60, "period": 60 } }
  ],
  // 00:10 UTC: yesterday's over-cap digest to the team, and the retention sweep (src/limits.ts daily()). Every five
  // minutes: the work sweep (src/ledger.ts sweep()): unsent team notices, intake mail for a newly listed address, and
  // tickets no team email or follow-up covers.
  "triggers": { "crons": ["10 0 * * *", "*/5 * * * *"] },
  "vars": {
    "STAGE": "production",
    "PUBLIC_URL": "https://support.nightmail.dev",
    // bane.mx until the cutover: its dashboard GETs redirect, but a tab opened before the switch can still start a chat.
    "DASHBOARD_ORIGINS": "https://nightmail.dev,https://bane.mx",
    "NIGHTMAIL_ORIGIN": "https://nightmail.dev",
    "SUPPORT_ADDRESS": "support@nightmail.dev",
    // The inbound address ID (mbx_…) of SUPPORT_ADDRESS in the platform workspace (ws_90b0…), created 2026-11-17.
    // support@bane.mx (mbx_7e7e64495349496691b2ca188cf48b6e) keeps its route to the same webhook, and replies in its
    // threads go out from it (src/nightmail.ts reply), so BANE_SUPPORT_INBOX_KEY must cover both addresses.
    "SUPPORT_ADDRESS_ID": "mbx_8969af953f9148ef9deb3cfee54bfe37",
    // Every address the agent answers (the replay poller and the key self-check): exactly what BANE_SUPPORT_INBOX_KEY reads.
    "SUPPORT_ADDRESSES": "support@nightmail.dev,support@bane.mx",
    "TICKET_TO": "ryan@anoma.ly",
    // Straight to tickets, never to the agent (src/intake.ts): their own webhook and API key.
    // bane.mx's three stay listed (and in BANE_INTAKE_INBOX_KEY) until the cutover; acknowledgements go out from the
    // address the mail came in on.
    "INTAKE_ADDRESSES": "abuse@nightmail.dev,privacy@nightmail.dev,legal@nightmail.dev,abuse@bane.mx,privacy@bane.mx,legal@bane.mx",
    // Console's inference gateway (Anthropic Messages API). The key is the CONSOLE_GATEWAY_KEY secret.
    "GATEWAY_URL": "https://opencode.ai/inference/anthropic/v1"
  },
  // Secrets, set with `wrangler secret put <NAME> --config wrangler.prod.jsonc` (never through CI):
  // CONSOLE_GATEWAY_KEY, SUPPORT_ROOT_SECRET, BANE_INBOUND_WEBHOOK_SECRET, BANE_SUPPORT_INBOX_KEY,
  // BANE_INTAKE_WEBHOOK_SECRET, BANE_INTAKE_INBOX_KEY.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": true,
    "logs": { "enabled": true, "invocation_logs": false },
    "traces": { "enabled": false }
  }
}
