// Support, dev (support.dev.nightmail.com; support.dev.bane.mx stays a custom domain): the support agent's Worker beside nightmail-dev in anomaly-dev. Service bindings
// only work inside one account, so dev binds nightmail-dev and production binds bane-production. See support/README.md for
// the one-time setup (D1 database, address, webhook, secrets) and the deploy.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nightmail-support-dev",
  "account_id": "d8e944f537ceef3f06a5bd3aec1d7a53",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "support.dev.nightmail.com", "custom_domain": true }, { "pattern": "support.dev.bane.mx", "custom_domain": true }],
  "minify": true,
  // The system prompt and the voice guide are Markdown files bundled as text.
  "rules": [{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }],
  "durable_objects": { "bindings": [{ "name": "CONVERSATION", "class_name": "SupportConversation" }, { "name": "INTAKE", "class_name": "SupportIntake" }] },
  "migrations": [{ "tag": "transfer-from-bane-support-dev", "transferred_classes": [
    { "from_script": "bane-support-dev", "from": "SupportConversation", "to": "SupportConversation" },
    { "from_script": "bane-support-dev", "from": "SupportIntake", "to": "SupportIntake" }
  ] }],
  // Copied from the original dev database in anomaly-dev (ENAM).
  "d1_databases": [{ "binding": "DB", "database_name": "nightmail-support-dev", "database_id": "85618a27-e93c-4089-af60-ca8b32248f5e", "migrations_dir": "migrations" }],
  // Screenshots (chat uploads and email image attachments): private, with a 90-day lifecycle rule (support/README.md).
  "r2_buckets": [{ "binding": "UPLOADS", "bucket_name": "nightmail-support-dev-uploads" }],
  // Downscales screenshots too large to send to the model (Cloudflare Images binding; optional in code).
  "images": { "binding": "IMAGES" },
  "services": [
    // Bane's SupportPlatform entrypoint (api/src/support-platform.ts): handoffs, sender checks, grants, grant reads.
    { "binding": "BANE", "service": "nightmail-dev", "entrypoint": "SupportPlatform" },
    // Bane's public API, called with the support address's API key (limited to that address).
    { "binding": "BANE_API", "service": "nightmail-dev" }
  ],
  // Rate limiter namespaces are per account; Bane's own use 8794001–8794002.
  "ratelimits": [
    { "name": "CHAT_START", "namespace_id": "8794101", "simple": { "limit": 5, "period": 60 } },
    // Per sender address; and one key across all inbound mail at a higher rate (the Worker answers 503, Bane retries).
    { "name": "EMAIL_IN", "namespace_id": "8794102", "simple": { "limit": 10, "period": 60 } },
    { "name": "EMAIL_IN_GLOBAL", "namespace_id": "8794103", "simple": { "limit": 120, "period": 60 } }
  ],
  // 00:10 UTC: yesterday's over-cap digest to the team, and the retention sweep (src/limits.ts daily()).
  "triggers": { "crons": ["10 0 * * *"] },
  "vars": {
    "STAGE": "dev",
    "PUBLIC_URL": "https://support.dev.nightmail.com",
    "DASHBOARD_ORIGINS": "https://dev.nightmail.com,https://dev.bane.mx,http://localhost:5173",
    "BANE_ORIGIN": "https://dev.nightmail.com",
    "SUPPORT_ADDRESS": "support@dev.nightmail.com",
    // The inbound address ID (mbx_…) of SUPPORT_ADDRESS in dev's platform workspace; set after creating it.
    "SUPPORT_ADDRESS_ID": "",
    "TICKET_TO": "ryan@anoma.ly",
    // Straight to tickets, never to the agent (src/intake.ts): their own webhook and API key.
    "INTAKE_ADDRESSES": "abuse@dev.nightmail.com,privacy@dev.nightmail.com,legal@dev.nightmail.com",
    // Console's inference gateway (Anthropic Messages API). The key is the CONSOLE_GATEWAY_KEY secret.
    "GATEWAY_URL": "https://opencode.ai/inference/anthropic/v1"
  },
  // Secrets, set with `wrangler secret put <NAME> --config wrangler.dev.jsonc` (never through CI):
  // CONSOLE_GATEWAY_KEY, SUPPORT_ROOT_SECRET, BANE_INBOUND_WEBHOOK_SECRET, BANE_SUPPORT_INBOX_KEY,
  // BANE_INTAKE_WEBHOOK_SECRET, BANE_INTAKE_INBOX_KEY.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": true,
    "logs": { "enabled": true, "invocation_logs": false },
    "traces": { "enabled": false }
  }
}
