// Dev only. dev.nightmail.com is canonical; dev.bane.mx stays a custom domain (API, SNS feedback; GETs redirected by its zone).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nightmail-dev",
  "account_id": "d8e944f537ceef3f06a5bd3aec1d7a53",
  "workers_dev": false,
  "routes": [{ "pattern": "dev.nightmail.com", "custom_domain": true }, { "pattern": "dev.bane.mx", "custom_domain": true }],
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["nodejs_compat"],
  "alias": { "@aws-sdk/xml-builder": "@aws-sdk/xml-builder/dist-cjs/index.js" },
  "assets": {
    "directory": "../app/dist",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": ["/v1", "/v1/*", "/api", "/api/*", "/mcp", "/mcp/*", "/.well-known", "/.well-known/*", "/unsubscribe", "/unsubscribe/*", "/health", "/health/*", "/internal/*", "/openapi.json", "/docs.md", "/docs/operations/*", "/docs/tags/*", "/llms.txt"]
  },
  "vars": {
    "BANE_MAIL_BUCKET": "nightmail-dev-mail",
    "BANE_MAIL_STORE": "r2",
    "PUBLIC_URL": "https://dev.nightmail.com",
    // The earlier origin, still served (see wrangler.prod.jsonc). Removed by the cutover.
    "PREVIOUS_PUBLIC_URLS": "https://dev.bane.mx",
    // The pool's SNS subscriptions stay on dev.bane.mx (infra/pulumi stage.origin).
    "SES_FEEDBACK_URL": "https://dev.bane.mx/v1/events/ses",
    "ACCOUNT_ISSUER": "https://account.dev.anoma.ly",
    "ACCOUNT_REQUIRED_ACR": "urn:anomaly:acr:google",
    // Staff sign-up: the Google Workspace domain (hd) of the sign-in's provider identity, never an address.
    "AUTH_STAFF_GOOGLE_DOMAINS": "anoma.ly",
    // Staff UI notes (src/ui-notes.ts): off on dev until Ryan's account.dev.anoma.ly subject is listed here.
    "UI_NOTES_SUBJECTS": "",
    "ACCOUNT_CLIENT_ID": "bane-dev",
    "MULTI_TENANT": "true",
    "BANE_PLATFORM_AWS_ACCOUNT": "905840579680",
    // The dedicated account only has the v8 policies: tenants and identities must be created with their pool tags.
    "BANE_REGIONAL_SENDING": "true",
    "BANE_TRUSTED_POOL": "true",
    "BANE_REQUIRE_DMARC_FOR_BULK": "true",
    "BANE_HOSTED_SCREEN": "true",
    "BANE_RECEIVING_REDRIVE": "true",
    // Dev only: the pools become ready in the SES sandbox, so dev can send to the mailbox simulator and verified addresses.
    "BANE_ALLOW_SES_SANDBOX": "true",
    "HOSTED_SEND_CAP_FIRST_WEEK": "100",
    "HOSTED_SEND_CAP_SECOND_WEEK": "1000",
    "HOSTED_SEND_CAP_MATURE": "10000",
    "DEFAULT_SES_REGION": "us-east-2",
    // Stripe Tax stays off until its registrations exist (api/README.md, Stripe setup). The keys are Worker secrets.
    "STRIPE_AUTOMATIC_TAX": "false",
    // Live SES uses the shared-account key (infra/aws-shared). Sends stay denied by its IAM policy
    // until every send carries an SES TenantName.
    "ENABLE_LIVE_SES": "true",
    "JOB_CONCURRENCY": "6",
    "SIMULATED_SES_LATENCY_MS": "170",
    "SIMULATED_SES_RATE": "5000",
    "DISPATCH_SHARDS": "4",
    "DISPATCH_RATE_FACTOR": "1.1",
    "API_RATE_LIMIT_PER_MINUTE": "10000",
    "WORK_QUEUE_NAME": "nightmail-dev-work",
    "WEBHOOK_QUEUE_NAME": "nightmail-dev-webhooks",
    "FEEDBACK_QUEUE_NAME": "nightmail-dev-feedback-v2",
    "FEEDBACK_DLQ_NAME": "nightmail-dev-feedback-v2-dlq",
    "LEGACY_FEEDBACK_DLQ_NAME": "nightmail-dev-feedback-dlq",
    // The queue the previous Worker version wrote to; consumed until it and its dead letters are drained, then removed.
    "LEGACY_FEEDBACK_QUEUE_NAME": "nightmail-dev-feedback",
    // Set once to the recorded UTC cutover after fencing old producers. Empty quarantines every unsigned item.
    "LEGACY_FEEDBACK_CUTOVER": "",
    // Support reads this Worker's own request lines from Workers Logs (GET /v1/support/requests). The token is the
    // CF_OBSERVABILITY_TOKEN secret (api/README.md "Support integration").
    "CF_OBSERVABILITY_ACCOUNT_ID": "d8e944f537ceef3f06a5bd3aec1d7a53",
    "CF_OBSERVABILITY_SCRIPT": "nightmail-dev",
    // The support agent (support/): "Contact support" hands off here, and staff sign-in returns to its /staff/callback.
    // The handoff's Ed25519 key is the BANE_SUPPORT_SIGNING_KEY secret.
    "BANE_SUPPORT_URL": "https://support.dev.nightmail.com/chat"
  },
  "durable_objects": { "bindings": [{ "name": "DISPATCHER", "class_name": "DispatcherShard" }] },
  // Run HTTP requests next to the nightmail/dev database (PlanetScale aws-us-east-2).
  "placement": { "region": "aws:us-east-2" },
  "migrations": [{ "tag": "transfer-from-bane-dev", "transferred_classes": [{ "from_script": "bane-dev", "from": "DispatcherShard", "to": "DispatcherShard" }] }],
  // Hyperdrive config `nightmail-dev` in anomaly-dev (caching disabled, 10 origin connections). The database allows 25 (22
  // for non-superusers), and Hyperdrive can open a second pool with its own allocation, so two pools must fit: at 15,
  // a second pool exhausted the database and Postgres refused connections mid-E2E (2026-11-11).
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "1e39000095604539b994ea966a744ced" }],
  "browser": { "binding": "BROWSER" },
  "r2_buckets": [{ "binding": "ATTACHMENTS", "bucket_name": "nightmail-dev-attachments" }, { "binding": "MAIL", "bucket_name": "nightmail-dev-mail" }],
  "queues": {
    "producers": [
      { "binding": "WAKE_QUEUE", "queue": "nightmail-dev-work" },
      { "binding": "WEBHOOK_QUEUE", "queue": "nightmail-dev-webhooks" },
      { "binding": "FEEDBACK_DLQ", "queue": "nightmail-dev-feedback-v2-dlq" },
      { "binding": "LEGACY_FEEDBACK_DLQ", "queue": "nightmail-dev-feedback-dlq" },
      { "binding": "FEEDBACK_QUEUE", "queue": "nightmail-dev-feedback-v2" }
    ],
    "consumers": [
      // Wake messages are hints, not jobs: drain Postgres once for hints already waiting together.
      { "queue": "nightmail-dev-work", "max_batch_size": 1, "max_batch_timeout": 0, "max_retries": 3, "max_concurrency": 8 },
      // Start an idle callback immediately; arrivals during its DB round trip form the next batch.
      { "queue": "nightmail-dev-webhooks", "max_batch_size": 8, "max_batch_timeout": 0, "max_retries": 3, "max_concurrency": 2 },
      { "queue": "nightmail-dev-feedback-v2", "max_batch_size": 100, "max_batch_timeout": 0, "max_retries": 5, "max_concurrency": 1, "dead_letter_queue": "nightmail-dev-feedback-v2-dlq" },
      // Legacy lane (untagged items from the previous version); remove with LEGACY_FEEDBACK_QUEUE_NAME once drained.
      { "queue": "nightmail-dev-feedback", "max_batch_size": 100, "max_batch_timeout": 0, "max_retries": 5, "max_concurrency": 1, "dead_letter_queue": "nightmail-dev-feedback-dlq" },
      // Both DLQs archive to PostgreSQL/R2, never ingest. Cross-redrive keeps storage outages recoverable.
      { "queue": "nightmail-dev-feedback-v2-dlq", "max_batch_size": 10, "max_batch_timeout": 1, "max_retries": 100, "retry_delay": 300, "max_concurrency": 1, "dead_letter_queue": "nightmail-dev-feedback-dlq" },
      { "queue": "nightmail-dev-feedback-dlq", "max_batch_size": 10, "max_batch_timeout": 1, "max_retries": 100, "retry_delay": 300, "max_concurrency": 1, "dead_letter_queue": "nightmail-dev-feedback-v2-dlq" }
    ]
  },
  "triggers": { "crons": ["* * * * *", "7 * * * *"] },
  // Rate limiter namespaces are per account; these are unused in anomaly-dev.
  "ratelimits": [
    { "name": "ADMISSION", "namespace_id": "8794001", "simple": { "limit": 6000, "period": 60 } },
    { "name": "SNS_CERT_MISSES", "namespace_id": "8794002", "simple": { "limit": 60, "period": 60 } }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": true,
    "logs": { "enabled": true, "invocation_logs": false },
    "traces": { "enabled": false }
  }
}
