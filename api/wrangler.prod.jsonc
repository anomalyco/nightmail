// Production. nightmail.dev is the canonical host; bane.mx stays a custom domain (API, the legacy bane-* topics' SNS, unsubscribe links;
// dashboard and docs GETs are 301ed to nightmail.dev by the bane.mx zone's redirect rule). opensend.mx stays on the old Worker.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nightmail-production",
  "define": { "NIGHTMAIL_AWS_NAMES": "true" },
  "account_id": "15d29c8639fd3733b1b5486a2acfd968",
  "workers_dev": false,
  "routes": [{ "pattern": "nightmail.dev", "custom_domain": true }, { "pattern": "bane.mx", "custom_domain": true }, { "pattern": "events.nightmail.dev", "custom_domain": true }],
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["nodejs_compat"],
  "alias": { "@aws-sdk/xml-builder": "@aws-sdk/xml-builder/dist-cjs/index.js" },
  "assets": {
    "directory": "../app/dist",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": ["/", "/pricing", "/compare", "/compare/*", "/v1", "/v1/*", "/api", "/api/*", "/mcp", "/mcp/*", "/.well-known", "/.well-known/*", "/unsubscribe", "/unsubscribe/*", "/health", "/health/*", "/internal/*", "/openapi.json", "/docs.md", "/docs/operations/*", "/docs/tags/*", "/llms.txt"]
  },
  "vars": {
    "BANE_MAIL_BUCKET": "nightmail-prod-mail",
    "BYO_STACK_PREFIX": "Nightmail",
    // Connected AWS accounts' SNS topics and stacks report here, and their role allows only this host.
    "BYO_EVENTS_ORIGIN": "https://events.nightmail.dev",
    "BANE_MAIL_STORE": "r2",
    "PUBLIC_URL": "https://nightmail.dev",
    // Mail apps connect to imap.nightmail.dev and smtp.nightmail.dev (the gateway certificate names both). Shown only
    // while the deploy binds MAILGW_API_TOKEN (bane:mailGatewayEnabled in infra/pulumi/Pulumi.production.yaml).
    "MAILGW_PUBLIC_DOMAIN": "nightmail.dev",
    // The earlier origin: still served, its /mcp audience valid for tokens minted there, and bane.mx stays a platform
    // domain (its adopted claim keeps receiving support@ and friends). Removed by the cutover.
    "PREVIOUS_PUBLIC_URLS": "https://bane.mx",
    // The nightmail-* topics' SNS subscriptions (infra/pulumi stage.origin). A signed confirmation is accepted only
    // for this endpoint (hosted_topic_cutover); the legacy bane-* subscriptions stay on bane.mx. Connected accounts
    // (BYO) deliver to BYO_EVENTS_ORIGIN when it's set, else here.
    "SES_FEEDBACK_URL": "https://nightmail.dev/v1/events/ses",
    "ACCOUNT_ISSUER": "https://account.anoma.ly",
    // Sign-in at the account service with GitHub, Google, an emailed link or code, or an email and password (its chooser
    // offers what it has for this client); nothing else is accepted. Only Google can be staff (api/src/account-policy.ts).
    "ACCOUNT_REQUIRED_ACR": "urn:anomaly:acr:github urn:anomaly:acr:google urn:anomaly:acr:email urn:anomaly:acr:password",
    // MCP asks for nightmail:* scopes, on both hosts; bane:* grants are still accepted until the cutover.
    "OAUTH_SCOPE_PREFIX": "nightmail",
    // Staff sign-up: the Google Workspace domain (hd) of the sign-in's provider identity, never an address. Only a
    // Google sign-in is staff; GitHub signs in members and existing users.
    "AUTH_STAFF_GOOGLE_DOMAINS": "anoma.ly,vogel.dev",
    // Staff UI notes (src/ui-notes.ts) for these issuer subjects only, who must also be operators: Ryan alone.
    "UI_NOTES_SUBJECTS": "https://account.anoma.ly 0YLDsWUOonmIl3RQqb3yHQ",
    // Dashboard usage analytics (docs/analytics.md): batches go to the ANALYTICS bucket, never Postgres. "off" discards them.
    "DASHBOARD_ANALYTICS": "on",
    // The domain setup reminder email (src/domain-setup.ts). Off: turning it on sends real email to customers.
    // The DNS check and the dashboard's banner run either way.
    "DOMAIN_SETUP_REMINDER": "off",
    // The email to a new workspace with no domain an hour after sign-up (src/domain-setup.ts). Off for the same reason.
    "NO_DOMAIN_REMINDER": "off",
    // Abuse monitoring (src/abuse.ts) records from this instant on, monitor-only (NIGHTMAIL_ABUSE_ENFORCE stays unset).
    "NIGHTMAIL_ABUSE_MONITORING": "2026-11-21T15:30:00Z",
    "ACCOUNT_CLIENT_ID": "bane-production",
    "MULTI_TENANT": "true",
    "BANE_PLATFORM_AWS_ACCOUNT": "009882681002",
    // Anomaly owns nightmail.dev and bane.mx (both adopted by scripts/adopt-platform-domain.ts). Every other workspace is refused.
    "BANE_PLATFORM_DOMAIN_WORKSPACE": "ws_90b0696c835f49fbaa9396fb726e9fe2",
    // Owner notices (standing, billing) by email, from the adopted platform domain through the platform workspace above.
    "BANE_NOTIFY_FROM": "system@nightmail.dev",
    // The shared test sender (src/test-sender.ts): a workspace with no verified domain sends its members a test from it,
    // through the platform workspace above and its adopted nightmail.dev identity.
    "NIGHTMAIL_TEST_SENDER": "onboarding@nightmail.dev",
    // Every waitlist join and sign-up is kept as a contact in this list of the platform workspace above (src/signups.ts).
    "NIGHTMAIL_SIGNUPS_LIST_ID": "lst_e665f46fedd040e5b0fcc009a9eb11c3",
    "BANE_REGIONAL_SENDING": "true",
    "BANE_TRUSTED_POOL": "true",
    "BANE_REQUIRE_DMARC_FOR_BULK": "true",
    "BANE_HOSTED_SCREEN": "true",
    "BANE_RECEIVING_REDRIVE": "true",
    // BYO_TEMPLATE_URL stays unset until a template is published in the dedicated account.
    "DEFAULT_SES_REGION": "us-east-2",
    // Stripe Tax is on: registrations are set up through Sphere (api/README.md, Stripe setup). The keys are Worker secrets.
    "STRIPE_AUTOMATIC_TAX": "true",
    // Live SES uses the shared-account key (infra/aws-shared). Sends stay denied by its IAM policy
    // until every send carries an SES TenantName.
    "ENABLE_LIVE_SES": "true",
    "JOB_CONCURRENCY": "6",
    "SIMULATED_SES_LATENCY_MS": "170",
    "SIMULATED_SES_RATE": "5000",
    "DISPATCH_SHARDS": "8",
    "DISPATCH_RATE_FACTOR": "1.05",
    // The customer share: outside workspaces together may use this percent of each shared account's SES daily limit.
    "HOSTED_CUSTOMER_SHARE_PERCENT": "50",
    "API_RATE_LIMIT_PER_MINUTE": "10000",
    "WORK_QUEUE_NAME": "nightmail-prod-work",
    "WEBHOOK_QUEUE_NAME": "nightmail-prod-webhooks",
    "JEVF_QUEUE_NAME": "nightmail-prod-jevf",
    "FEEDBACK_QUEUE_NAME": "nightmail-prod-feedback-v2",
    "FEEDBACK_PRIORITY_QUEUE_NAME": "nightmail-prod-feedback-priority",
    "FEEDBACK_DLQ_NAME": "nightmail-prod-feedback-v2-dlq",
    "LEGACY_FEEDBACK_DLQ_NAME": "nightmail-prod-feedback-dlq",
    // The queue the previous Worker version wrote to; consumed until it and its dead letters are drained, then removed.
    "LEGACY_FEEDBACK_QUEUE_NAME": "nightmail-prod-feedback",
    // Set once to the recorded UTC cutover after fencing old producers. Empty quarantines every unsigned item.
    "LEGACY_FEEDBACK_CUTOVER": "",
    // Support reads this Worker's own request lines from Workers Logs (GET /v1/support/requests). The token is the
    // CF_OBSERVABILITY_TOKEN secret (api/README.md "Support integration").
    "CF_OBSERVABILITY_ACCOUNT_ID": "15d29c8639fd3733b1b5486a2acfd968",
    "CF_OBSERVABILITY_SCRIPT": "nightmail-production",
    // The support agent (support/): "Contact support" hands off here, and staff sign-in returns to its /staff/callback.
    // The handoff's Ed25519 key is the BANE_SUPPORT_SIGNING_KEY secret.
    "BANE_SUPPORT_URL": "https://support.nightmail.dev/chat"
  },
  // CAMPAIGN_ROOMS: one per campaign, who has it open in the dashboard (src/campaign-room.ts).
  "durable_objects": { "bindings": [{ "name": "DISPATCHER", "class_name": "DispatcherShard" }, { "name": "CAMPAIGN_ROOMS", "class_name": "CampaignRoom" }] },
  // Run HTTP requests next to the bane-prod database (PlanetScale aws-us-east-2), as production does.
  "placement": { "region": "aws:us-east-2" },
  "migrations": [{ "tag": "transfer-from-bane-production", "transferred_classes": [{ "from_script": "bane-production", "from": "DispatcherShard", "to": "DispatcherShard" }] }, { "tag": "campaign-rooms", "new_sqlite_classes": ["CampaignRoom"] }],
  // Operator-verified nightmail/production runtime origin; the workflow checks the matching migrator.
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "4e85373aed5e4d5ca66e62fd13b254d2" }],
  "browser": { "binding": "BROWSER" },
  "r2_buckets": [{ "binding": "ATTACHMENTS", "bucket_name": "nightmail-prod-attachments" }, { "binding": "MAIL", "bucket_name": "nightmail-prod-mail" }, { "binding": "ANALYTICS", "bucket_name": "nightmail-prod-analytics" }],
  "queues": {
    // Wrangler binds by name. Work: 753a4b880016464c833b836a63663684; feedback: 34426f99502941fbbed927a059517b7c.
    "producers": [
      { "binding": "WAKE_QUEUE", "queue": "nightmail-prod-work" },
      { "binding": "WEBHOOK_QUEUE", "queue": "nightmail-prod-webhooks" },
      { "binding": "FEEDBACK_DLQ", "queue": "nightmail-prod-feedback-v2-dlq" },
      { "binding": "LEGACY_FEEDBACK_DLQ", "queue": "nightmail-prod-feedback-dlq" },
      { "binding": "FEEDBACK_QUEUE", "queue": "nightmail-prod-feedback-v2" },
      { "binding": "FEEDBACK_PRIORITY_QUEUE", "queue": "nightmail-prod-feedback-priority" },
      // The second classifier in the content screen's shadow (src/screen-shadow.ts). Nothing is sent to it without JEVF_API_KEY.
      { "binding": "JEVF_QUEUE", "queue": "nightmail-prod-jevf" }
    ],
    "consumers": [
      // The only place the second classifier is called: four calls an invocation (and the database's connection, of an
      // invocation's six) by two invocations, eight calls in all. A batch whose rows could not be written is delivered
      // again twice, then gone: no dead-letter queue, and a redelivered request is recorded as lost, never asked again.
      { "queue": "nightmail-prod-jevf", "max_batch_size": 4, "max_batch_timeout": 1, "max_retries": 2, "max_concurrency": 2 },
      // Wake messages are hints, not jobs: drain Postgres once for hints already waiting together.
      { "queue": "nightmail-prod-work", "max_batch_size": 1, "max_batch_timeout": 0, "max_retries": 3, "max_concurrency": 8 },
      // Each wake opens up to six delivery slots. Don't merge a burst of wake hints into one drain.
      { "queue": "nightmail-prod-webhooks", "max_batch_size": 1, "max_batch_timeout": 0, "max_retries": 3, "max_concurrency": 12 },
      { "queue": "nightmail-prod-feedback-v2", "max_batch_size": 100, "max_batch_timeout": 0, "max_retries": 5, "max_concurrency": 6, "dead_letter_queue": "nightmail-prod-feedback-v2-dlq" },
      { "queue": "nightmail-prod-feedback-priority", "max_batch_size": 100, "max_batch_timeout": 0, "max_retries": 5, "max_concurrency": 4, "dead_letter_queue": "nightmail-prod-feedback-v2-dlq" },
      // Legacy lane (untagged items from the previous version); remove with LEGACY_FEEDBACK_QUEUE_NAME once drained.
      { "queue": "nightmail-prod-feedback", "max_batch_size": 100, "max_batch_timeout": 0, "max_retries": 5, "max_concurrency": 1, "dead_letter_queue": "nightmail-prod-feedback-dlq" },
      // Both DLQs archive to PostgreSQL/R2, never ingest. Cross-redrive keeps storage outages recoverable.
      { "queue": "nightmail-prod-feedback-v2-dlq", "max_batch_size": 10, "max_batch_timeout": 1, "max_retries": 100, "retry_delay": 300, "max_concurrency": 1, "dead_letter_queue": "nightmail-prod-feedback-dlq" },
      { "queue": "nightmail-prod-feedback-dlq", "max_batch_size": 10, "max_batch_timeout": 1, "max_retries": 100, "retry_delay": 300, "max_concurrency": 1, "dead_letter_queue": "nightmail-prod-feedback-v2-dlq" }
    ]
  },
  "triggers": { "crons": ["* * * * *", "7 * * * *"] },
  // Rate limiter namespaces are per account.
  "ratelimits": [
    { "name": "ADMISSION", "namespace_id": "8793301", "simple": { "limit": 6000, "period": 60 } },
    { "name": "SNS_CERT_MISSES", "namespace_id": "8793302", "simple": { "limit": 60, "period": 60 } },
    // Analytics batches per client address a minute (src/analytics.ts ANALYTICS_BATCHES_PER_MINUTE).
    { "name": "ANALYTICS_INGEST", "namespace_id": "8793303", "simple": { "limit": 60, "period": 60 } },
    // Database disk cards a minute per storage threshold (src/disk-alert.ts).
    { "name": "DISK_ALERT", "namespace_id": "8793304", "simple": { "limit": 1, "period": 60 } }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": true,
    "logs": { "enabled": true, "invocation_logs": false },
    "traces": { "enabled": false }
  }
}
