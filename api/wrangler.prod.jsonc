// Production. nightmail.com is the canonical host; bane.mx stays a custom domain (API, SNS feedback, unsubscribe links;
// dashboard and docs GETs are 301ed to nightmail.com by the bane.mx zone's redirect rule). opensend.mx stays on the old Worker.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bane-production",
  "account_id": "15d29c8639fd3733b1b5486a2acfd968",
  "workers_dev": false,
  "routes": [{ "pattern": "nightmail.com", "custom_domain": true }, { "pattern": "bane.mx", "custom_domain": true }],
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["nodejs_compat"],
  "alias": { "@aws-sdk/xml-builder": "@aws-sdk/xml-builder/dist-cjs/index.js" },
  "assets": {
    "directory": "../app/dist",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": ["/v1", "/v1/*", "/api", "/api/*", "/mcp", "/mcp/*", "/.well-known", "/.well-known/*", "/unsubscribe", "/unsubscribe/*", "/health", "/health/*", "/internal/*", "/openapi.json", "/docs.md", "/docs/operations/*", "/docs/tags/*", "/llms.txt"]
  },
  "vars": {
    "BANE_MAIL_BUCKET": "bane-prod-mail",
    "BANE_MAIL_STORE": "r2",
    "PUBLIC_URL": "https://nightmail.com",
    // The earlier origin: still served, its /mcp audience valid for tokens minted there, and bane.mx stays a platform
    // domain (its adopted claim keeps receiving support@ and friends). Removed by the cutover.
    "PREVIOUS_PUBLIC_URLS": "https://bane.mx",
    // SNS keeps delivering to bane.mx: BYO stacks' IAM conditions pin https://bane.mx/v1/events/ses, and the pool's
    // subscriptions (infra/pulumi, stage.origin) stay on it. bane.mx serves this path for good.
    "SES_FEEDBACK_URL": "https://bane.mx/v1/events/ses",
    "ACCOUNT_ISSUER": "https://account.anoma.ly",
    "ACCOUNT_REQUIRED_ACR": "urn:anomaly:acr:google",
    // MCP asks for nightmail:* scopes (bane:* still accepted until the cutover). Needs account.anoma.ly to know them.
    "OAUTH_SCOPE_PREFIX": "nightmail",
    // Staff sign-up: the Google Workspace domain (hd) of the sign-in's provider identity, never an address.
    "AUTH_STAFF_GOOGLE_DOMAINS": "anoma.ly",
    // Staff UI notes (src/ui-notes.ts) for these issuer subjects only, who must also be operators: Ryan alone.
    "UI_NOTES_SUBJECTS": "https://account.anoma.ly 0YLDsWUOonmIl3RQqb3yHQ",
    "ACCOUNT_CLIENT_ID": "bane-production",
    "MULTI_TENANT": "true",
    "BANE_PLATFORM_AWS_ACCOUNT": "009882681002",
    // Anomaly owns nightmail.com and bane.mx (both adopted by scripts/adopt-platform-domain.ts). Every other workspace is refused.
    "BANE_PLATFORM_DOMAIN_WORKSPACE": "ws_90b0696c835f49fbaa9396fb726e9fe2",
    // Owner notices (standing, billing) by email, from the adopted platform domain through the platform workspace above.
    "BANE_NOTIFY_FROM": "system@nightmail.com",
    "BANE_REGIONAL_SENDING": "true",
    "BANE_TRUSTED_POOL": "true",
    "BANE_REQUIRE_DMARC_FOR_BULK": "true",
    "BANE_HOSTED_SCREEN": "true",
    "BANE_RECEIVING_REDRIVE": "true",
    "HOSTED_SEND_CAP_FIRST_WEEK": "100",
    "HOSTED_SEND_CAP_SECOND_WEEK": "1000",
    "HOSTED_SEND_CAP_MATURE": "10000",
    // BYO_TEMPLATE_URL stays unset until a template is published in the dedicated account.
    "DEFAULT_SES_REGION": "us-east-2",
    // Stripe Tax stays off until its registrations exist (api/README.md, Stripe setup). The keys are Worker secrets.
    "STRIPE_AUTOMATIC_TAX": "false",
    // Live SES uses the shared-account key (infra/aws-shared). Sends stay denied by its IAM policy
    // until every send carries an SES TenantName.
    "ENABLE_LIVE_SES": "true",
    "JOB_CONCURRENCY": "6",
    "SIMULATED_SES_LATENCY_MS": "170",
    "SIMULATED_SES_RATE": "5000",
    "DISPATCH_SHARDS": "8",
    "DISPATCH_RATE_FACTOR": "1.1",
    "API_RATE_LIMIT_PER_MINUTE": "10000",
    "WORK_QUEUE_NAME": "bane-prod-work",
    "WEBHOOK_QUEUE_NAME": "bane-prod-webhooks",
    "FEEDBACK_QUEUE_NAME": "bane-prod-feedback-v2",
    "FEEDBACK_DLQ_NAME": "bane-prod-feedback-v2-dlq",
    "LEGACY_FEEDBACK_DLQ_NAME": "bane-prod-feedback-dlq",
    // The queue the previous Worker version wrote to; consumed until it and its dead letters are drained, then removed.
    "LEGACY_FEEDBACK_QUEUE_NAME": "bane-prod-feedback",
    // Set once to the recorded UTC cutover after fencing old producers. Empty quarantines every unsigned item.
    "LEGACY_FEEDBACK_CUTOVER": "",
    // Support reads this Worker's own request lines from Workers Logs (GET /v1/support/requests). The token is the
    // CF_OBSERVABILITY_TOKEN secret (api/README.md "Support integration").
    "CF_OBSERVABILITY_ACCOUNT_ID": "15d29c8639fd3733b1b5486a2acfd968",
    "CF_OBSERVABILITY_SCRIPT": "bane-production",
    // The support agent (support/): "Contact support" hands off here, and staff sign-in returns to its /staff/callback.
    // The handoff's Ed25519 key is the BANE_SUPPORT_SIGNING_KEY secret.
    "BANE_SUPPORT_URL": "https://support.nightmail.com/chat"
  },
  "durable_objects": { "bindings": [{ "name": "DISPATCHER", "class_name": "DispatcherShard" }] },
  // Run HTTP requests next to the bane-prod database (PlanetScale aws-us-east-2), as production does.
  "placement": { "region": "aws:us-east-2" },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DispatcherShard"] }],
  // Existing production Hyperdrive, outside infra/pulumi.
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "556aba191add406eaa58a0e26eebb6b1" }],
  "browser": { "binding": "BROWSER" },
  "r2_buckets": [{ "binding": "ATTACHMENTS", "bucket_name": "bane-prod-attachments" }, { "binding": "MAIL", "bucket_name": "bane-prod-mail" }],
  "queues": {
    // Wrangler binds by name. Work: 753a4b880016464c833b836a63663684; feedback: 34426f99502941fbbed927a059517b7c.
    "producers": [
      { "binding": "WAKE_QUEUE", "queue": "bane-prod-work" },
      { "binding": "WEBHOOK_QUEUE", "queue": "bane-prod-webhooks" },
      { "binding": "FEEDBACK_DLQ", "queue": "bane-prod-feedback-v2-dlq" },
      { "binding": "LEGACY_FEEDBACK_DLQ", "queue": "bane-prod-feedback-dlq" },
      { "binding": "FEEDBACK_QUEUE", "queue": "bane-prod-feedback-v2" }
    ],
    "consumers": [
      // Wake messages are hints, not jobs: drain Postgres once for hints already waiting together.
      { "queue": "bane-prod-work", "max_batch_size": 1, "max_batch_timeout": 0, "max_retries": 3, "max_concurrency": 8 },
      // Each wake opens up to six delivery slots. Don't merge a burst of wake hints into one drain.
      { "queue": "bane-prod-webhooks", "max_batch_size": 1, "max_batch_timeout": 0, "max_retries": 3, "max_concurrency": 12 },
      { "queue": "bane-prod-feedback-v2", "max_batch_size": 100, "max_batch_timeout": 0, "max_retries": 5, "max_concurrency": 1, "dead_letter_queue": "bane-prod-feedback-v2-dlq" },
      // Legacy lane (untagged items from the previous version); remove with LEGACY_FEEDBACK_QUEUE_NAME once drained.
      { "queue": "bane-prod-feedback", "max_batch_size": 100, "max_batch_timeout": 0, "max_retries": 5, "max_concurrency": 1, "dead_letter_queue": "bane-prod-feedback-dlq" },
      // Both DLQs archive to PostgreSQL/R2, never ingest. Cross-redrive keeps storage outages recoverable.
      { "queue": "bane-prod-feedback-v2-dlq", "max_batch_size": 10, "max_batch_timeout": 1, "max_retries": 100, "retry_delay": 300, "max_concurrency": 1, "dead_letter_queue": "bane-prod-feedback-dlq" },
      { "queue": "bane-prod-feedback-dlq", "max_batch_size": 10, "max_batch_timeout": 1, "max_retries": 100, "retry_delay": 300, "max_concurrency": 1, "dead_letter_queue": "bane-prod-feedback-v2-dlq" }
    ]
  },
  "triggers": { "crons": ["* * * * *", "7 * * * *"] },
  // Rate limiter namespaces are per account.
  "ratelimits": [
    { "name": "ADMISSION", "namespace_id": "8793301", "simple": { "limit": 6000, "period": 60 } },
    { "name": "SNS_CERT_MISSES", "namespace_id": "8793302", "simple": { "limit": 60, "period": 60 } }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": true,
    "logs": { "enabled": true, "invocation_logs": false },
    "traces": { "enabled": false }
  }
}
